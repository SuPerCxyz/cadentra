[Unit]
Description=Cadentra Hub
Documentation=file:///usr/share/doc/cadentra
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cadentra
Group=cadentra
ExecStart=/usr/local/bin/cadentra-hub --config /etc/cadentra/hub.yaml
Restart=on-failure
RestartSec=5
StateDirectory=cadentra-hub
StateDirectoryMode=0750
# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cadentra-hub /etc/cadentra

[Install]
WantedBy=multi-user.target
